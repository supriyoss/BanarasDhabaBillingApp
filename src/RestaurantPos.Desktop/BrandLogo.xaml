<UserControl x:Class="RestaurantPos.Desktop.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Banaras Dhaba logo"
             IsHitTestVisible="False"
             Opacity="0">
  <Grid x:Name="LogoSurface" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="LogoScale" ScaleX="0.9" ScaleY="0.9"/>
    </Grid.RenderTransform>
    <Ellipse x:Name="LogoGlow" Margin="3" Fill="#FFF3BF">
      <Ellipse.Effect>
        <DropShadowEffect x:Name="GlowEffect" Color="#F59E0B" BlurRadius="18" ShadowDepth="0" Opacity="0.2"/>
      </Ellipse.Effect>
    </Ellipse>
    <Ellipse Margin="5" Stroke="#FFFFF4" StrokeThickness="2">
      <Ellipse.Fill>
        <ImageBrush ImageSource="/RestaurantPos.Desktop;component/Assets/BanarasDhabaLogo.png" Stretch="UniformToFill"/>
      </Ellipse.Fill>
    </Ellipse>
  </Grid>
</UserControl>
