<Window x:Class="RestaurantPos.Desktop.FloorPlanWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dining floor plan" Height="760" Width="1180" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Dining floor plan" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Select a table to start or reopen its order." Foreground="#64748B"/></StackPanel><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/><ComboBox x:Name="LayoutSelector" DockPanel.Dock="Right" Width="180" DisplayMemberPath="Name" SelectionChanged="LayoutChanged"/></DockPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="FloorGrid" Background="White" MinHeight="580" MinWidth="900"/></ScrollViewer></Grid>
</Window>
