<Window x:Class="RestaurantPos.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Restaurant POS" Height="820" Width="1320" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#1E293B" BlurRadius="16" ShadowDepth="2" Opacity="0.08"/></Setter.Value></Setter></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#26344D"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="CompactAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#EEF2F7"/><Setter Property="Foreground" Value="#334155"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="2"/></Style>
    <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#26344D"/><Setter Property="Foreground" Value="#E2E8F0"/></Style>
    <Style x:Key="QuantityButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="5,1"/><Setter Property="Margin" Value="1"/><Setter Property="MinWidth" Value="24"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="TableTile" TargetType="ListBoxItem"><Setter Property="Margin" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#E0EAFC"/><Setter TargetName="Tile" Property="BorderBrush" Value="#93C5FD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#2563EB"/><Setter TargetName="Tile" Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="#F4F7FB"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#101827" Padding="25,15"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="RESTAURANT POS" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/><TextBlock Text="Counter workspace" Foreground="White" FontSize="23" FontWeight="SemiBold"/></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="42,6,0,0"><Button x:Name="PosNavButton" Style="{StaticResource NavButton}" Content="POS" Click="ShowPos_Click"/><Button x:Name="HeldOrdersNavButton" Style="{StaticResource NavButton}" Content="Held orders" Click="ShowHeldOrders_Click"/><Button x:Name="ReportsNavButton" Style="{StaticResource NavButton}" Content="Reports" Click="ShowReports_Click"/><Button x:Name="AdminNavButton" Style="{StaticResource NavButton}" Content="Admin" Click="ShowAdmin_Click" Visibility="Collapsed"/></StackPanel><Button Style="{StaticResource HeaderAction}" Content="Log out" Click="Logout_Click" DockPanel.Dock="Right"/><Button x:Name="BackupNavButton" Style="{StaticResource HeaderAction}" Content="Back up now" Click="BackupNow_Click" DockPanel.Dock="Right"/><Border x:Name="OfflineReadyIndicator" Background="#1E2D46" CornerRadius="12" Padding="10,5" Margin="0,6,12,0" DockPanel.Dock="Right" Visibility="Collapsed"><Grid MinWidth="110"><TextBlock Text="OFFLINE READY" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></DockPanel></Border>
    <Grid Grid.Row="1" Margin="20">
      <Grid x:Name="PosScreen"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Menu" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Search or select an item to add it to the bill." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><Button Style="{StaticResource CompactAction}" Content="Add" ToolTip="Add selected item to bill" Click="AddItem_Click" IsEnabled="{Binding HasActiveOrder}" DockPanel.Dock="Right"/></DockPanel><TextBox x:Name="MenuSearchInput" Margin="0,12,0,0" TextChanged="MenuSearchInput_TextChanged" ToolTip="Search menu items or categories"/></StackPanel><DataGrid x:Name="MenuGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="MenuGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding MenuCategory.Name}" Width="*"/><DataGridTextColumn Header="Price (INR)" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="120"/></DataGrid.Columns></DataGrid></DockPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="StaffText" Text="Current order" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Build, hold, and settle the current bill." Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,15,0,12"><TextBlock Text="CREATE A NEW BILL" Foreground="#64748B" FontSize="11" FontWeight="Bold"/><Grid Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="TakeawayButton" Style="{StaticResource CompactAction}" Content="Start takeaway" Click="TakeawayOrder_Click" Margin="0,4,4,4"/><Button x:Name="DineInButton" Grid.Column="1" Style="{StaticResource CompactAction}" Content="Start dine-in" Click="BeginDineIn_Click" Margin="4"/></Grid><StackPanel x:Name="TableSelectionPanel" Visibility="Collapsed"><TextBlock Text="Choose a table to open the dine-in bill" Foreground="#64748B" Margin="0,5,0,5"/><ListBox x:Name="TableSelector" Height="102" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TableTile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="TableSelector_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></StackPanel>
          <DataGrid Grid.Row="2" x:Name="CartGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" HeadersVisibility="Column" MinHeight="185"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*"/><DataGridTemplateColumn Header="Qty" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource QuantityButton}" Content="-" Click="DecreaseLineQuantity_Click" IsEnabled="{Binding DataContext.HasActiveOrder, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource QuantityButton}" Content="+" Click="IncreaseLineQuantity_Click" IsEnabled="{Binding DataContext.HasActiveOrder, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="80"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Margin="0,12,0,6"><TextBlock x:Name="OrderInfoText" Foreground="#64748B"/><Border Background="#EEF4FF" CornerRadius="7" Padding="10" Margin="0,5,0,5"><TextBlock x:Name="TotalsText" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A8A"/></Border><StackPanel Orientation="Horizontal"><Button Content="Hold" Click="Hold_Click" IsEnabled="{Binding HasActiveOrder}"/><Button Content="Resume" Click="Resume_Click" IsEnabled="{Binding HasActiveOrder}"/></StackPanel><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,8,0,0"><StackPanel><TextBlock Text="Bill discount" FontWeight="SemiBold" Foreground="#334155"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="PercentageDiscountButton" Style="{StaticResource PrimaryButton}" Content="Percent" Click="PercentageDiscount_Click"/><Button x:Name="FixedDiscountButton" Style="{StaticResource CompactAction}" Content="Amount" Click="FixedDiscount_Click"/><TextBox x:Name="BillDiscountValueInput" Width="70" Height="30" Padding="7,3" VerticalContentAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/><Button Style="{StaticResource CompactAction}" Content="Apply" Click="ApplyBillDiscount_Click" IsEnabled="{Binding HasActiveOrder}"/></StackPanel></StackPanel></Border></StackPanel>
          <StackPanel Grid.Row="4" Margin="0,7,0,0"><TextBlock Text="Payment method" FontWeight="SemiBold" Foreground="#334155"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Button x:Name="CashPaymentButton" Style="{StaticResource PrimaryButton}" Content="Cash" Click="CashPayment_Click"/><Button x:Name="CardPaymentButton" Style="{StaticResource CompactAction}" Content="Card" Click="CardPayment_Click"/><Button x:Name="UpiPaymentButton" Style="{StaticResource CompactAction}" Content="UPI" Click="UpiPayment_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Pay exact amount" Click="Pay_Click" IsEnabled="{Binding HasActiveOrder}"/><Button Content="Reprint invoice" Click="Reprint_Click" IsEnabled="{Binding HasPaidOrder}"/></StackPanel><TextBlock x:Name="StatusText" Foreground="#475569" TextWrapping="Wrap" Margin="6"/></StackPanel>
        </Grid></ScrollViewer></Border>
      </Grid>
      <Border x:Name="HeldOrdersScreen" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Held orders" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Resume a saved bill whenever the customer is ready." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Click="RefreshHeldOrders_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Resume selected order" Click="ResumeHeldOrder_Click"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="HeldOrdersGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="HeldOrdersGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="Table" Binding="{Binding DiningTable.Name}" Width="140"/><DataGridTextColumn Header="Opened" Binding="{Binding OpenedUtc, StringFormat={}{0:dd MMM HH:mm}}" Width="160"/><DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="120"/></DataGrid.Columns></DataGrid></Grid></Border>
      <Border x:Name="ReportsScreen" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Daily report" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="A clear view of sales, GST, and staff activity." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><DatePicker x:Name="BusinessDate" Margin="4" SelectedDateChanged="BusinessDate_Changed"/><Button Content="Refresh" Click="RefreshReport_Click"/></StackPanel></DockPanel><Border Grid.Row="1" Background="#EEF4FF" CornerRadius="9" Padding="15" Margin="0,20,0,14"><StackPanel Orientation="Horizontal"><TextBlock x:Name="OrderCountText" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,45,0"/><TextBlock x:Name="SalesTotalText" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,45,0"/><TextBlock x:Name="TaxTotalText" FontWeight="SemiBold" Foreground="#1E3A8A"/></StackPanel></Border><Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Payment breakdown" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/><DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="135"><DataGrid.Columns><DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel><Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="18" Margin="25,28,0,0"><TextBlock Text="All figures include the selected business day in the computer's local time zone." Foreground="#64748B" TextWrapping="Wrap"/></Border></Grid><StackPanel Grid.Row="3"><TextBlock Text="Recent activity" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/><DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding OccurredUtc, StringFormat={}{0:HH:mm:ss}}" Width="100"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/><DataGridTextColumn Header="Record" Binding="{Binding EntityId}" Width="140"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Grid></Border>
      <Border x:Name="AdminScreen" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Administrator workspace" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Manage staff, your PIN, menu items, and recent sales history." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="AdminStatusText" DockPanel.Dock="Right" Foreground="#2563EB" VerticalAlignment="Center"/></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Background="#F8FAFC" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Add staff account" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Create a non-administrator staff account." Foreground="#64748B" Margin="0,3,0,10"/><TextBlock Text="Name" FontWeight="SemiBold"/><TextBox x:Name="NewStaffNameInput"/><TextBlock Text="Temporary PIN" FontWeight="SemiBold" Margin="4,6,4,0"/><PasswordBox x:Name="NewStaffPinInput" Margin="4" Height="34" Padding="9,6" BorderBrush="#CBD5E1" BorderThickness="1"/><TextBlock Text="Role" FontWeight="SemiBold" Margin="4,6,4,0"/><ListBox x:Name="NewStaffRoleSelector" Margin="4" Height="44" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TableTile}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><Button Style="{StaticResource PrimaryButton}" Content="Add staff member" Click="AddStaff_Click"/></StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Background="#F8FAFC" Padding="16" Margin="10,0,0,12"><StackPanel><TextBlock Text="Change my PIN" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use at least four digits." Foreground="#64748B" Margin="0,3,0,10"/><TextBlock Text="Current PIN" FontWeight="SemiBold"/><PasswordBox x:Name="CurrentPinInput" Margin="4" Height="34" Padding="9,6" BorderBrush="#CBD5E1" BorderThickness="1"/><TextBlock Text="New PIN" FontWeight="SemiBold" Margin="4,6,4,0"/><PasswordBox x:Name="NewPinInput" Margin="4" Height="34" Padding="9,6" BorderBrush="#CBD5E1" BorderThickness="1"/><Button Content="Update my PIN" Click="ChangePin_Click"/></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource Card}" Background="#F8FAFC" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Border Background="#EEF4FF" CornerRadius="8" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="Bill GST rate" FontSize="17" FontWeight="SemiBold" Foreground="#1E3A8A"/><TextBlock Text="Applied to all newly created bills." Foreground="#64748B" Margin="0,2,0,5"/><StackPanel Orientation="Horizontal"><TextBox x:Name="GstRateInput" Width="82" Height="30" VerticalContentAlignment="Center"/><TextBlock Text="%" VerticalAlignment="Center" Margin="4"/><Button Style="{StaticResource CompactAction}" Content="Update" Click="UpdateGstRate_Click"/></StackPanel></StackPanel></Border><TextBlock Text="Add menu item" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="New items appear in the POS menu immediately." Foreground="#64748B" Margin="0,3,0,10"/><TextBlock Text="Category" FontWeight="SemiBold"/><ListBox x:Name="NewMenuCategorySelector" Height="48" Margin="4" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TableTile}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><TextBlock Text="Item name" FontWeight="SemiBold" Margin="4,4,4,0"/><TextBox x:Name="NewMenuItemNameInput" Margin="4"/><TextBlock Text="Price" FontWeight="SemiBold" Margin="4,4,4,0"/><TextBox x:Name="NewMenuPriceInput" Margin="4"/><Button Style="{StaticResource PrimaryButton}" Content="Add menu item" Click="AddMenuItem_Click"/></StackPanel><StackPanel Grid.Column="1" Margin="30,0,0,0"><TextBlock Text="Staff accounts" FontSize="18" FontWeight="SemiBold"/><DataGrid x:Name="StaffGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10,0,0" Height="175"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="75"/></DataGrid.Columns></DataGrid></StackPanel></Grid></Border>
        <Border Style="{StaticResource Card}" Background="#F8FAFC" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Order history" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Paid orders for the selected day only." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><DatePicker x:Name="HistoryFromDate" Margin="4"/><Button Content="Load history" Click="LoadHistory_Click"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,14,0,0" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/><DataGridTextColumn Header="Closed" Binding="{Binding ClosedUtc, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="165"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Table" Binding="{Binding DiningTable.Name}" Width="110"/><DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="105"/></DataGrid.Columns></DataGrid></Grid></Border>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <StatusBar Grid.Row="2"><StatusBarItem Content="Local-first restaurant billing"/></StatusBar>
  </Grid>
</Window>
