    <Style x:Key="RightAlignedHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,7,14,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
