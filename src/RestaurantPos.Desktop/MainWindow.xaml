    <Style x:Key="ModernMenuGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="44"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="CanUserResizeColumns" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border x:Name="RowSurface" Margin="0,2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><DataGridCellsPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#F8FAFC"/><Setter TargetName="RowSurface" Property="BorderBrush" Value="#BFDBFE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EFF6FF"/><Setter TargetName="RowSurface" Property="BorderBrush" Value="#60A5FA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter><Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></Setter.Value></Setter><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="#F4F7FB"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="WorkspaceTitleBar" Background="#101827" Padding="25,0,0,0" MouseLeftButtonDown="WorkspaceTitleBar_MouseLeftButtonDown"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,8,0,8"><local:BrandLogo Width="46" Height="46" Margin="-3,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="BANARAS DHABA POS" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/><TextBlock Text="Restaurant workspace" Foreground="White" FontSize="23" FontWeight="SemiBold"/></StackPanel></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="32,14,0,8"><Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Content="Home" Click="ShowHome_Click"/><Button x:Name="PosNavButton" Style="{StaticResource NavButton}" Content="Current order" Click="ShowPos_Click"/><Button x:Name="HeldOrdersNavButton" Style="{StaticResource NavButton}" Content="Held orders" Click="ShowHeldOrders_Click"/><Button x:Name="ReportsNavButton" Style="{StaticResource NavButton}" Content="Reports" Click="ShowReports_Click"/><Button x:Name="MenuManagementNavButton" Style="{StaticResource NavButton}" Content="Menu" Click="ShowMenuManagement_Click" Visibility="Collapsed"/><Button x:Name="AdminNavButton" Style="{StaticResource NavButton}" Content="Admin" Click="ShowAdmin_Click" Visibility="Collapsed"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button Style="{StaticResource WindowCaptionButton}" Content="—" ToolTip="Minimize" AutomationProperties.Name="Minimize window" Click="MinimizeWindow_Click"/><Button x:Name="RestoreWindowButton" Style="{StaticResource WindowCaptionButton}" Content="❐" ToolTip="Restore" AutomationProperties.Name="Restore window" Click="RestoreWindow_Click"/><Button Style="{StaticResource CloseWindowCaptionButton}" Content="✕" ToolTip="Close" AutomationProperties.Name="Close window" Click="CloseWindow_Click"/></StackPanel><Button Style="{StaticResource HeaderAction}" Content="Log out" Click="Logout_Click" DockPanel.Dock="Right" Margin="4,10"/><Button x:Name="BackupNavButton" Style="{StaticResource HeaderAction}" Content="Back up now" Click="BackupNow_Click" DockPanel.Dock="Right" Margin="4,10"/><Border x:Name="OfflineReadyIndicator" Background="#1E2D46" CornerRadius="12" Padding="10,5" Margin="0,14,12,8" DockPanel.Dock="Right" Visibility="Collapsed"><Grid MinWidth="110"><TextBlock Text="OFFLINE READY" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></DockPanel></Border>
    <Grid Grid.Row="1" Margin="20">
      <Grid x:Name="HomeScreen" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="760">
          <TextBlock Text="How would you like to serve this order?" FontSize="31" FontWeight="SemiBold" Foreground="#172033" TextAlignment="Center"/>
          <TextBlock Text="Choose a service mode to begin. Dining opens the restaurant floor; takeaway starts a counter order." Foreground="#64748B" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="70,8,70,28"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="HomeDiningButton" Click="HomeDining_Click" Margin="0,0,10,0" Padding="28" Background="#DBEAFE"><StackPanel><TextBlock Text="DINE-IN" FontSize="25" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center"/><TextBlock Text="Choose a table and manage its running order" Foreground="#475569" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Button>
            <Button x:Name="HomeTakeawayButton" Grid.Column="1" Click="HomeTakeaway_Click" Margin="10,0,0,0" Padding="28" Background="#DCFCE7"><StackPanel><TextBlock Text="TAKEAWAY" FontSize="25" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/><TextBlock Text="Create or continue a counter order" Foreground="#475569" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Button>
          </Grid>
          <Button x:Name="FloorPlanEditorButton" Content="Edit floor plan" Click="EditFloorPlan_Click" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed"/>
          <Border x:Name="LastReceiptPanel" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,0" Visibility="Collapsed"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Last completed receipt" FontWeight="SemiBold" Foreground="#334155"/><TextBlock x:Name="LastReceiptText" Foreground="#64748B" Margin="0,2,12,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource CompactAction}" Content="Export compact PDF" Click="ExportLastReceiptPdf_Click"/></DockPanel></Border>
          <TextBlock x:Name="HomeStaffText" Foreground="#64748B" TextAlignment="Center" Margin="0,22,0,0"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="PosScreen"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="360"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*" MinWidth="420"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,4,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><StackPanel><TextBlock Text="Menu" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Search or filter, then add an item to the current order." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="MenuSearchInput" Margin="0,12,0,0" TextChanged="MenuSearchInput_TextChanged" ToolTip="Search menu items or categories"/></StackPanel><DataGrid x:Name="MenuGrid" Style="{StaticResource ModernMenuGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource CenteredCellText}"/><DataGridTextColumn Header="Category" Binding="{Binding MenuCategory.Name}" Width="*" ElementStyle="{StaticResource CenteredCellText}"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="88" ElementStyle="{StaticResource RightAlignedCellText}" HeaderStyle="{StaticResource RightAlignedHeader}"/><DataGridTemplateColumn Header="" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource CompactAction}" Content="Add" Padding="7,3" Tag="{Binding Id}" Click="AddMenuItemToOrder_Click" IsEnabled="{Binding DataContext.HasActiveOrder, RelativeSource={RelativeSource AncestorType=Window}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></Border>
        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE" IsTabStop="True" AutomationProperties.Name="Resize menu and current order panels"><GridSplitter.Template><ControlTemplate TargetType="{x:Type GridSplitter}"><Grid Background="Transparent"><Border Width="3" Background="#CBD5E1" CornerRadius="2" HorizontalAlignment="Center" Margin="0,12"/></Grid></ControlTemplate></GridSplitter.Template></GridSplitter>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="StaffText" Text="Current order" FontSize="20" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Manage items, discounts, and payment for the selected order." Foreground="#64748B" Margin="0,2,0,0"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,15,0,12"><TextBlock Text="CREATE A NEW BILL" Foreground="#64748B" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,2"><TextBlock Text="Server name (optional)" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="ServerNameInput" Width="220" Margin="10,0,0,0" ToolTip="Optional server name printed on this bill"/></StackPanel><Grid Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="TakeawayButton" Style="{StaticResource CompactAction}" Content="Start takeaway" Click="TakeawayOrder_Click" Margin="0,4,4,4"/><Button x:Name="DineInButton" Grid.Column="1" Style="{StaticResource CompactAction}" Content="Start dine-in" Click="BeginDineIn_Click" Margin="4"/></Grid><StackPanel x:Name="TableSelectionPanel" Visibility="Collapsed"><TextBlock Text="Choose a table to open the dine-in bill" Foreground="#64748B" Margin="0,5,0,5"/><ListBox x:Name="TableSelector" Height="102" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TableTile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="TableSelector_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></StackPanel>
          <DataGrid Grid.Row="2" x:Name="CartGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" HeadersVisibility="Column" MinHeight="185"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*"/><DataGridTemplateColumn Header="Qty" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource QuantityButton}" Content="-" Click="DecreaseLineQuantity_Click" IsEnabled="{Binding DataContext.HasActiveOrder, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource QuantityButton}" Content="+" Click="IncreaseLineQuantity_Click" IsEnabled="{Binding DataContext.HasActiveOrder, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Amount" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="90"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Margin="0,12,0,6"><TextBlock x:Name="OrderInfoText" Foreground="#64748B"/><StackPanel Orientation="Horizontal" Margin="0,5,0,3"><Button x:Name="LeaveOrderButton" Content="Return to home" Click="LeaveOrder_Click" IsEnabled="{Binding HasActiveOrder}"/></StackPanel><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,5,0,0"><StackPanel><TextBlock Text="Bill discount" FontWeight="SemiBold" Foreground="#334155"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="PercentageDiscountButton" Style="{StaticResource PrimaryButton}" Content="Percent" Click="PercentageDiscount_Click"/><Button x:Name="FixedDiscountButton" Style="{StaticResource CompactAction}" Content="Amount" Click="FixedDiscount_Click"/><TextBox x:Name="BillDiscountValueInput" Width="70" Height="30" Padding="7,3" VerticalContentAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/><Button Style="{StaticResource CompactAction}" Content="Apply" Click="ApplyBillDiscount_Click" IsEnabled="{Binding HasActiveOrder}"/></StackPanel><Border Background="#EEF4FF" CornerRadius="7" Padding="10" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Discount" Foreground="#1E3A8A"/><TextBlock x:Name="BillDiscountTotalText" Grid.Column="1" Foreground="#1E3A8A" TextAlignment="Right"/><TextBlock Grid.Row="1" Text="GST" Foreground="#1E3A8A" Margin="0,4,0,0"/><TextBlock x:Name="GstTotalText" Grid.Row="1" Grid.Column="1" Foreground="#1E3A8A" TextAlignment="Right" Margin="0,4,0,0"/><TextBlock Grid.Row="2" Text="Total" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,6,0,0"/><TextBlock x:Name="GrandTotalText" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Foreground="#1E3A8A" TextAlignment="Right" Margin="0,6,0,0"/></Grid></Border></StackPanel></Border></StackPanel>
          <StackPanel Grid.Row="4" Margin="0,7,0,0"><TextBlock Text="Payment method" FontWeight="SemiBold" Foreground="#334155"/><WrapPanel Margin="0,3,0,0"><Button x:Name="CashPaymentButton" Style="{StaticResource PrimaryButton}" Content="Cash" Click="CashPayment_Click"/><Button x:Name="CardPaymentButton" Style="{StaticResource CompactAction}" Content="Card" Click="CardPayment_Click"/><Button x:Name="UpiPaymentButton" Style="{StaticResource CompactAction}" Content="UPI" Click="UpiPayment_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Pay exact amount" Click="Pay_Click" IsEnabled="{Binding HasActiveOrder}"/><Button x:Name="ReprintButton" Content="Reprint invoice" Click="Reprint_Click" Visibility="Collapsed"/></WrapPanel><TextBlock x:Name="StatusText" Foreground="#475569" TextWrapping="Wrap" Margin="6"/></StackPanel>
        </Grid></ScrollViewer></Border>
      </Grid>
      <Border x:Name="HeldOrdersScreen" Style="{StaticResource Card}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Held orders" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Resume a saved bill whenever the customer is ready." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Click="RefreshHeldOrders_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Resume selected order" Click="ResumeHeldOrder_Click"/></StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10">
            <DataGrid x:Name="HeldOrdersGrid" Style="{StaticResource ModernMenuGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" MouseDoubleClick="HeldOrdersGrid_DoubleClick">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Invoice" Width="1.6*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Margin="5,0,6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding InvoiceNumber}" FontWeight="SemiBold" Foreground="#172033" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="TAKEAWAY" Foreground="#047857" FontSize="10" FontWeight="Bold"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Server" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock x:Name="ServerValue" VerticalAlignment="Center" Margin="5,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding ServerName}"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ServerName}" Value=""><Setter Property="Text" Value="Not specified"/><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                              <DataTrigger Binding="{Binding ServerName}" Value="{x:Null}"><Setter Property="Text" Value="Not specified"/><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Opened" Width="155">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding OpenedLocal, StringFormat={}{0:dd MMM HH:mm}}" Foreground="#172033" VerticalAlignment="Center" Margin="5,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </Border>
      <Border x:Name="ReportsScreen" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="ReportTitleText" Text="Daily sales report" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock x:Name="ReportDescriptionText" Text="Sales, GST, payments, and activity for the selected day." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><DatePicker x:Name="BusinessDate" Margin="4" SelectedDateChanged="BusinessDate_Changed"/><Button Content="Refresh" Click="RefreshReport_Click"/></StackPanel></DockPanel>
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,18,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Report period" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="4,0,8,0"/><Button x:Name="DailyReportButton" Style="{StaticResource PrimaryButton}" Content="Daily" Click="DailyReport_Click"/><Button x:Name="MonthlyReportButton" Style="{StaticResource CompactAction}" Content="Monthly" Click="MonthlyReport_Click"/><Button x:Name="YearlyReportButton" Style="{StaticResource CompactAction}" Content="Yearly" Click="YearlyReport_Click"/></StackPanel></Border>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,6,0"><TextBlock x:Name="OrderCountText" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A8A"/></Border><Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6,0"><TextBlock x:Name="SalesTotalText" FontSize="16" FontWeight="SemiBold" Foreground="#166534"/></Border><Border Grid.Column="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6,0,0,0"><TextBlock x:Name="TaxTotalText" FontSize="16" FontWeight="SemiBold" Foreground="#9A3412"/></Border></Grid>
        <Grid Grid.Row="3" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="Payment breakdown" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,7"/><DataGrid x:Name="PaymentsGrid" Style="{StaticResource ModernMenuGrid}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="135"><DataGrid.Columns><DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18" Margin="14,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Average paid bill" Foreground="#64748B" FontWeight="SemiBold"/><TextBlock x:Name="AverageBillText" Foreground="#172033" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Calculated from paid bills in the selected period." Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></Grid>
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="Recent activity (local time)" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,7"/><DataGrid x:Name="AuditGrid" Style="{StaticResource ModernMenuGrid}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Date &amp; time" Binding="{Binding OccurredLocal, StringFormat={}{0:dd MMM HH:mm:ss}}" Width="165"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/><DataGridTextColumn Header="Record" Binding="{Binding EntityId}" Width="140"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
      </Grid></Border>
      <Border x:Name="MenuManagementScreen" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Menu management" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Review the active menu and remove items that should no longer be offered." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Click="RefreshMenuManagement_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Remove selected" Click="DeactivateMenuItems_Click"/></StackPanel></DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0">Add menu item</TextBlock><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold"><Run Text="Category"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><ListBox x:Name="NewMenuCategorySelector" Height="40" Margin="0,4,10,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TableTile}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel><StackPanel Grid.Column="2"><TextBlock FontWeight="SemiBold"><Run Text="Item name"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><TextBox x:Name="NewMenuItemNameInput" Margin="0,4,10,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock FontWeight="SemiBold"><Run Text="Price"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><TextBox x:Name="NewMenuPriceInput" Margin="0,4,10,0" TextAlignment="Right"/></StackPanel><Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Add item" Click="AddMenuItem_Click" VerticalAlignment="Top" Margin="8,22,0,0"/></Grid></Border>
        <DataGrid Grid.Row="2" x:Name="AdminMenuGrid" Style="{StaticResource ModernMenuGrid}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="1.3*" ElementStyle="{StaticResource CenteredCellText}"/><DataGridTextColumn Header="Category" Binding="{Binding MenuCategory.Name}" Width="*" ElementStyle="{StaticResource CenteredCellText}"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource RightAlignedCellText}" HeaderStyle="{StaticResource RightAlignedHeader}"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="3" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock Text="Removal is safe" FontWeight="SemiBold" Foreground="#9A3412"/><TextBlock Text="Removed items disappear from the staff POS. Existing bills and sales history are retained." Foreground="#9A3412" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Border>
        <TextBlock x:Name="MenuManagementStatusText" Grid.Row="3" Foreground="#2563EB" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,8"/>
      </Grid></Border>
      <Border x:Name="ApplicationMaintenanceScreen" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Application administration" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Monitor local operation, protect restaurant data, and perform application maintenance." Foreground="#64748B" Margin="0,3,0,18"/><Border Background="#EEF4FF" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="System status" FontSize="18" FontWeight="SemiBold" Foreground="#1E3A8A"/><TextBlock Text="The application is operating locally and remains available without an internet connection." Foreground="#475569" Margin="0,5,0,12" TextWrapping="Wrap"/><Button Content="Create database backup now" Click="BackupNow_Click" HorizontalAlignment="Left"/><TextBlock Text="Backups protect the local restaurant database and can be used during technical recovery." Foreground="#64748B" Margin="4,8,0,0"/></StackPanel></Border><TextBlock x:Name="ApplicationStatusText" Foreground="#2563EB" Margin="4,14,0,0"/></StackPanel></Border>
      <Border x:Name="AdminScreen" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Restaurant management" FontSize="25" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Manage staff, your PIN, menu items, floor plan, and recent sales history." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Edit floor plan" Click="EditFloorPlan_Click"/><TextBlock x:Name="AdminStatusText" DockPanel.Dock="Right" Foreground="#2563EB" VerticalAlignment="Center"/></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Background="#F8FAFC" Padding="16" Margin="0,0,10,12"><StackPanel><TextBlock Text="Add staff account" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Create a non-administrator staff account. Required fields are marked *" Foreground="#64748B" Margin="0,3,0,10"/><TextBlock FontWeight="SemiBold"><Run Text="Name"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><TextBox x:Name="NewStaffNameInput"/><TextBlock FontWeight="SemiBold" Margin="4,6,4,0"><Run Text="Temporary PIN"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><PasswordBox x:Name="NewStaffPinInput" Margin="4" Height="34" Padding="9,6" BorderBrush="#CBD5E1" BorderThickness="1"/><TextBlock Visibility="Collapsed" FontWeight="SemiBold" Margin="4,6,4,0"><Run Text="Role"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><ListBox x:Name="NewStaffRoleSelector" Margin="4" Height="44" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TableTile}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><Button Style="{StaticResource PrimaryButton}" Content="Add staff member" Click="AddStaff_Click"/></StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Background="#F8FAFC" Padding="16" Margin="10,0,0,12"><StackPanel><TextBlock Text="Change my PIN" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use at least four digits. Required fields are marked *" Foreground="#64748B" Margin="0,3,0,10"/><TextBlock FontWeight="SemiBold"><Run Text="Current PIN"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><PasswordBox x:Name="CurrentPinInput" Margin="4" Height="34" Padding="9,6" BorderBrush="#CBD5E1" BorderThickness="1"/><TextBlock FontWeight="SemiBold" Margin="4,6,4,0"><Run Text="New PIN"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><PasswordBox x:Name="NewPinInput" Margin="4" Height="34" Padding="9,6" BorderBrush="#CBD5E1" BorderThickness="1"/><Button Content="Update my PIN" Click="ChangePin_Click"/></StackPanel></Border>
        </Grid>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Background="#EEF4FF" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="Bill GST rate" FontSize="18" FontWeight="SemiBold" Foreground="#1E3A8A"/><TextBlock Text="Applied to all newly created bills." Foreground="#64748B" Margin="0,3,0,8"/><StackPanel Orientation="Horizontal"><TextBox x:Name="GstRateInput" Width="82" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="Bill GST rate"/><TextBlock Text="%" VerticalAlignment="Center" Margin="4"/><Button Style="{StaticResource CompactAction}" Content="Update" Click="UpdateGstRate_Click"/></StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}" Background="White" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="Physical receipt paper" FontSize="18" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Used when printing customer receipts." Foreground="#64748B" Margin="0,3,0,8"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="ReceiptPaperSelector" Width="120" Height="38" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="Physical receipt paper width"><ComboBoxItem Content="58 mm"/><ComboBoxItem Content="80 mm"/></ComboBox><Button Style="{StaticResource PrimaryButton}" Content="Apply" Click="ApplyReceiptPaperWidth_Click" Margin="8,0,0,0" AutomationProperties.Name="Apply physical receipt paper width"/></StackPanel><TextBlock x:Name="ReceiptPaperStatusText" Foreground="#2563EB" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}" Background="White" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="Staff accounts" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select one or more non-admin accounts to deactivate, or one account to reset its PIN." Foreground="#64748B" Margin="0,3,0,0"/><DataGrid x:Name="StaffGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeColumns="False" SelectionMode="Extended" Margin="0,10,0,0" Height="175" RowHeight="42" ColumnHeaderHeight="38"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.15*" ElementStyle="{StaticResource StaffNameCellText}"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="0.85*" ElementStyle="{StaticResource CenteredStaffCellText}" HeaderStyle="{StaticResource CenteredStaffHeader}"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="90" ElementStyle="{StaticResource CenteredStaffCheckBox}" HeaderStyle="{StaticResource CenteredStaffHeader}"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="New PIN"/><Run Text=" *" Foreground="#DC2626"/></TextBlock><PasswordBox x:Name="ResetStaffPinInput" Width="130" Margin="8,0" Height="30" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/><Button Style="{StaticResource CompactAction}" Content="Reset selected PIN" Click="ResetSelectedStaffPin_Click"/></StackPanel><Button Style="{StaticResource CompactAction}" Content="Deactivate selected staff" Click="DeactivateStaffAccounts_Click" HorizontalAlignment="Right" Margin="0,8,0,0"/></StackPanel></Border></Grid>
        <Border Style="{StaticResource Card}" Background="#F8FAFC" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Order history" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Paid orders for the selected day only." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><DatePicker x:Name="HistoryFromDate" Margin="4"/><Button Content="Load history" Click="LoadHistory_Click"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,14,0,0" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/><DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="130"/><DataGridTextColumn Header="Closed" Binding="{Binding ClosedUtc, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="165"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Table" Binding="{Binding DiningTable.Name}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="95"/></DataGrid.Columns></DataGrid></Grid></Border>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <StatusBar Grid.Row="2"><StatusBarItem Content="Local-first restaurant billing"/></StatusBar>
  </Grid>
</Window>
