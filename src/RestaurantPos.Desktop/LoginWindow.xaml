<Window x:Class="RestaurantPos.Desktop.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RestaurantPos.Desktop" Title="Banaras Dhaba POS" Icon="/RestaurantPos.Desktop;component/Assets/BanarasDhabaLogo.ico" Height="650" Width="900" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource AppCanvasBrush}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101827" Padding="34"><StackPanel VerticalAlignment="Center"><local:BrandLogo Width="88" Height="88" HorizontalAlignment="Left" Margin="-5,0,0,14"/><TextBlock Text="BANARAS DHABA POS" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"/><TextBlock Text="Ready for service." Foreground="White" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,12"/><TextBlock Text="A local-first counter workspace for fast, reliable restaurant billing." Foreground="#CBD5E1" FontSize="15" TextWrapping="Wrap" LineHeight="23"/><Border Background="#1E2D46" CornerRadius="8" Padding="12" Margin="0,30,0,0"><TextBlock Text="OFFLINE READY&#x0a;Your data stays on this computer." Foreground="#A7F3D0" FontSize="12" FontWeight="SemiBold" LineHeight="20"/></Border></StackPanel></Border>
    <Grid Grid.Column="1" Margin="44,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Welcome back" FontSize="26" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Sign in to start your shift." Foreground="#64748B" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="USER" Foreground="#64748B" FontSize="11" FontWeight="Bold"/><ComboBox x:Name="UserSelector" DisplayMemberPath="DisplayName" Margin="0,7,0,14" Height="37" IsEnabled="False"/><TextBlock Text="PIN" Foreground="#64748B" FontSize="11" FontWeight="Bold"/><PasswordBox x:Name="PinInput" Margin="0,7,0,8" Height="37" Padding="10,7" BorderBrush="#CBD5E1" BorderThickness="1" KeyDown="PinInput_KeyDown" IsEnabled="False"/><StackPanel x:Name="StartupProgressPanel" Margin="0,3,0,4"><ProgressBar Height="4" IsIndeterminate="True"/><TextBlock x:Name="StartupStatusText" Text="Preparing local restaurant data…" Foreground="#64748B" Margin="0,7,0,0"/></StackPanel><Border x:Name="LicenseStatusPanel" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,7,0,5" Visibility="Collapsed"><StackPanel><TextBlock x:Name="LicenseStatusTitle" Text="Access status" FontWeight="SemiBold" Foreground="#1E3A8A"/><TextBlock x:Name="LicenseStatusText" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,8"/><TextBlock Text="INSTALLATION ID" Foreground="#64748B" FontSize="10" FontWeight="Bold"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstallationIdInput" IsReadOnly="True" Height="34" Padding="9,4"/><Button Grid.Column="1" Content="Copy" Click="CopyInstallationId_Click" Padding="10,6" Margin="6,0,0,0"/></Grid><StackPanel x:Name="RenewalPanel" Visibility="Collapsed" Margin="0,9,0,0"><TextBlock Text="RENEWAL CODE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/><TextBox x:Name="RenewalCodeInput" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" ToolTip="Paste the signed renewal code supplied by the application provider"/><Button Content="Apply renewal code" Click="ApplyRenewalCode_Click" Background="#2563EB" Foreground="White" HorizontalAlignment="Stretch" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="LicenseActionText" Foreground="#1D4ED8" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="24"/><Button x:Name="RetryStartupButton" Content="Retry startup" Click="RetryStartup_Click" Visibility="Collapsed" Margin="0,3,0,0"/><Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click" Background="#2563EB" Foreground="White" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="14,11" IsEnabled="False"/></StackPanel></Grid>
  </Grid>
</Window>
