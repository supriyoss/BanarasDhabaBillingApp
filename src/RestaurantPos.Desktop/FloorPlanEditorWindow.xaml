<Window x:Class="RestaurantPos.Desktop.FloorPlanEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Banaras Dhaba POS" Height="720" Width="1040" WindowStartupLocation="CenterOwner" Background="{StaticResource AppCanvasBrush}">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,15"><StackPanel><TextBlock Text="Floor plan editor" FontSize="27" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Create floors and optional sections, then place tables on a simple grid." Foreground="#64748B"/></StackPanel><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/></DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel>
      <WrapPanel><TextBlock Text="Floor" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="LayoutSelector" Width="180" Margin="8,0,18,0" DisplayMemberPath="Name" SelectionChanged="LayoutChanged"/><TextBox x:Name="NewLayoutName" Width="150"/><Button Content="Add floor" Click="AddLayout_Click"/><TextBox x:Name="NewSectionName" Width="150" Margin="20,0,0,0"/><Button Content="Add section" Click="AddSection_Click"/></WrapPanel>
      <WrapPanel Margin="0,12,0,0"><TextBlock Text="Table" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="TableName" Width="100" Margin="8,0"/><TextBlock Text="Seats" VerticalAlignment="Center"/><TextBox x:Name="CapacityInput" Width="45" Text="4" Margin="5,0,12,0"/><TextBlock Text="X" VerticalAlignment="Center"/><TextBox x:Name="GridXInput" Width="40" Text="0" Margin="5,0,10,0"/><TextBlock Text="Y" VerticalAlignment="Center"/><TextBox x:Name="GridYInput" Width="40" Text="0" Margin="5,0,12,0"/><ComboBox x:Name="SectionSelector" Width="145" DisplayMemberPath="Name" Margin="0,0,12,0"/><ComboBox x:Name="ShapeSelector" Width="110"/><Button Background="#2563EB" Foreground="White" Content="Add table" Click="AddTable_Click"/></WrapPanel>
    </StackPanel></Border>
    <DataGrid Grid.Row="2" x:Name="TablesGrid" Margin="0,15,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Table" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Section" Binding="{Binding FloorSection.Name}" Width="160"/><DataGridTextColumn Header="Seats" Binding="{Binding Capacity}" Width="80"/><DataGridTextColumn Header="X" Binding="{Binding GridX}" Width="65"/><DataGridTextColumn Header="Y" Binding="{Binding GridY}" Width="65"/><DataGridTextColumn Header="Width" Binding="{Binding GridWidth}" Width="75"/><DataGridTextColumn Header="Height" Binding="{Binding GridHeight}" Width="75"/><DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="110"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="3" x:Name="EditorStatusText" Foreground="#2563EB" Margin="4,10,4,0"/>
  </Grid>
</Window>
