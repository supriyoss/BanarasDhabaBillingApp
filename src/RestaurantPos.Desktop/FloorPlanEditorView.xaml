<UserControl x:Class="RestaurantPos.Desktop.FloorPlanEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="Floor plan editor" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Create floors and sections, then place tables on the selected floor." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel>
      <Button DockPanel.Dock="Right" Content="Done" Click="Done_Click" Background="#2563EB" Foreground="White" Padding="18,9"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <StackPanel>
        <WrapPanel>
          <StackPanel Margin="0,0,14,10"><TextBlock Text="Floor" FontWeight="SemiBold" Margin="1,0,0,6"/><ComboBox x:Name="LayoutSelector" Width="200" DisplayMemberPath="Name" SelectionChanged="LayoutChanged"/></StackPanel>
          <StackPanel Margin="0,0,8,10"><TextBlock Text="New floor name" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="NewLayoutName" Width="170"/></StackPanel>
          <Button Content="Add floor" Click="AddLayout_Click" VerticalAlignment="Bottom" Margin="0,0,18,10"/>
          <StackPanel Margin="0,0,8,10"><TextBlock Text="New section name" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="NewSectionName" Width="170"/></StackPanel>
          <Button Content="Add section" Click="AddSection_Click" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
        </WrapPanel>
        <Separator Margin="0,4,0,14" Background="{StaticResource BorderBrush}"/>
        <WrapPanel>
          <StackPanel Margin="0,0,10,10"><TextBlock Text="Table name" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="TableName" Width="130"/></StackPanel>
          <StackPanel Margin="0,0,10,10"><TextBlock Text="Seats" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="CapacityInput" Width="70" Text="4"/></StackPanel>
          <StackPanel Margin="0,0,10,10"><TextBlock Text="Column" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="GridXInput" Width="70" Text="0"/></StackPanel>
          <StackPanel Margin="0,0,10,10"><TextBlock Text="Row" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="GridYInput" Width="70" Text="0"/></StackPanel>
          <StackPanel Margin="0,0,10,10"><TextBlock Text="Section" FontWeight="SemiBold" Margin="1,0,0,6"/><ComboBox x:Name="SectionSelector" Width="170" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel Margin="0,0,10,10"><TextBlock Text="Shape" FontWeight="SemiBold" Margin="1,0,0,6"/><ComboBox x:Name="ShapeSelector" Width="130"/></StackPanel>
          <Button Background="#2563EB" Foreground="White" Content="Add table" Click="AddTable_Click" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <DataGrid Grid.Row="2" x:Name="TablesGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Table" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Section" Binding="{Binding FloorSection.Name}" Width="160"/><DataGridTextColumn Header="Seats" Binding="{Binding Capacity}" Width="80"/><DataGridTextColumn Header="Column" Binding="{Binding GridX}" Width="75"/><DataGridTextColumn Header="Row" Binding="{Binding GridY}" Width="75"/><DataGridTextColumn Header="Width" Binding="{Binding GridWidth}" Width="75"/><DataGridTextColumn Header="Height" Binding="{Binding GridHeight}" Width="75"/><DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="110"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="3" Background="#EFF6FF" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"><TextBlock x:Name="EditorStatusText" Foreground="#1D4ED8"/></Border>
  </Grid>
</UserControl>
