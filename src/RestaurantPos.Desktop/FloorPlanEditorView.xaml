<UserControl x:Class="RestaurantPos.Desktop.FloorPlanEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="Floor plan editor" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Create floors and sections, then place tables on the selected floor." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel>
      <Button DockPanel.Dock="Right" Content="Done" Click="Done_Click" Width="82" Height="36" Padding="12,6" Margin="0" VerticalAlignment="Top"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Floor and section setup" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Create a floor, or add a section to the floor selected in the table area below." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,10"><TextBlock Text="New floor name" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="NewLayoutName" Height="40"/></StackPanel>
          <Button Grid.Column="1" Content="Add floor" Click="AddLayout_Click" Height="40" Padding="14,0" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
          <StackPanel Grid.Column="3" Margin="0,0,8,10"><TextBlock Text="New section name" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="NewSectionName" Height="40"/></StackPanel>
          <Button Grid.Column="4" Content="Add section" Click="AddSection_Click" Height="40" Padding="14,0" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
        </Grid>
        <Separator Margin="0,4,0,14" Background="{StaticResource BorderBrush}"/>
        <TextBlock Text="Add table" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Choose the destination floor, then enter the table details." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="170"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Floor for table" FontWeight="SemiBold" Margin="1,0,0,6"/><ComboBox x:Name="LayoutSelector" Height="40" DisplayMemberPath="Name" SelectionChanged="LayoutChanged"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,10,10"><TextBlock Text="Table name" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="TableName" Height="40" Padding="10,0" AcceptsReturn="False" TextWrapping="NoWrap" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,10,10"><TextBlock Text="Seats" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="CapacityInput" Height="40" Padding="0" Text="4" TextAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></StackPanel>
          <StackPanel Grid.Column="3" Margin="0,0,10,10"><TextBlock Text="Column" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="GridXInput" Height="40" Padding="0" Text="0" TextAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></StackPanel>
          <StackPanel Grid.Column="4" Margin="0,0,10,10"><TextBlock Text="Row" FontWeight="SemiBold" Margin="1,0,0,6"/><TextBox x:Name="GridYInput" Height="40" Padding="0" Text="0" TextAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></StackPanel>
          <StackPanel Grid.Column="5" Margin="0,0,10,10"><TextBlock Text="Section" FontWeight="SemiBold" Margin="1,0,0,6"/><ComboBox x:Name="SectionSelector" Height="40" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel Grid.Column="6" Margin="0,0,10,10"><TextBlock Text="Shape" FontWeight="SemiBold" Margin="1,0,0,6"/><ComboBox x:Name="ShapeSelector" Height="40"/></StackPanel>
          <Button Grid.Column="7" Background="#2563EB" Foreground="White" Content="Add table" Click="AddTable_Click" Height="40" Padding="14,0" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
        </Grid>
      </StackPanel>
    </Border>
    <DataGrid Grid.Row="2" x:Name="TablesGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Table" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Section" Binding="{Binding FloorSection.Name}" Width="160"/><DataGridTextColumn Header="Seats" Binding="{Binding Capacity}" Width="80"/><DataGridTextColumn Header="Column" Binding="{Binding GridX}" Width="75"/><DataGridTextColumn Header="Row" Binding="{Binding GridY}" Width="75"/><DataGridTextColumn Header="Width" Binding="{Binding GridWidth}" Width="75"/><DataGridTextColumn Header="Height" Binding="{Binding GridHeight}" Width="75"/><DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="110"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="3" Background="#EFF6FF" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"><TextBlock x:Name="EditorStatusText" Foreground="#1D4ED8"/></Border>
  </Grid>
</UserControl>
